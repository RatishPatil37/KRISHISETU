# ==============================================================
# KrishiSetu — Root .gitignore
# ==============================================================

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── Virtual environments ────────────────────────────────────────
.venv
.env
.env.*
*.env

# ── Node / JS ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── Sensitive credential files ──────────────────────────────────
Creds.txt
**/Creds.txt
credentials.json
**/credentials.json
secrets.json
**/secrets.json
service-account*.json
**/service-account*.json
google-credentials*.json
**/google-credentials*.json

# ── Temporary uploads (user-submitted documents) ────────────────
uploads/
**/uploads/

# ── Build outputs ───────────────────────────────────────────────
**/build/
**/dist/

# ── IDE / Editor folders ────────────────────────────────────────
.vscode/
.cursor/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ── AI / Gemini agent folders ───────────────────────────────────
.gemini/

# ── Docker & deployment secrets ─────────────────────────────────
docker-compose.override.yml

# ── Python virtual envs (extra patterns) ───────────────────────
venv/
env/
.Python
